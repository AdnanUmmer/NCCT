# Export these variables in your shell / hosting service. This file is not auto-loaded.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=https://ncctdxb.com
# Unset DATABASE_URL for local SQLite; production example:
# DATABASE_URL=postgresql://ncct:password@localhost:5432/ncct
# Set after enabling HTTPS at your reverse proxy:
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_TRUST_PROXY_SSL=1
# Render sets RENDER=true automatically, which enables proxy HTTPS recognition.
# Other hosts should enable DJANGO_TRUST_PROXY_SSL only behind a trusted proxy
# that strips/replaces incoming X-Forwarded-Proto.
# Render production values (set in the Render dashboard, not in this file):
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=ncct.onrender.com,design.theadvoxy.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ncct.onrender.com,https://design.theadvoxy.com
# DJANGO_SSL_REDIRECT=0
# Render handles HTTP -> HTTPS; Django redirects are disabled on Render even
# if a stale DJANGO_SSL_REDIRECT=1 value remains in the dashboard.
# DJANGO_TRUST_PROXY_SSL=1
# SITE_URL=https://design.theadvoxy.com
# Keep the existing DJANGO_SECRET_KEY and DATABASE_URL as private environment variables.

# Preview by default; enable only for the public launch.
SITE_INDEXABLE=0
# HSTS: enable after HTTPS is verified; subdomains and preload are opt-in.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
# Persistent admin-uploaded media (private S3-compatible bucket):
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# Optional enquiry notifications; enquiries save even when SMTP is absent/fails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=webmaster@localhost
ENQUIRY_NOTIFICATION_EMAIL=
ADMIN_LOGIN_RATE_LIMIT=20
