{
  "html": "<section class=\"section surface lighting-moments is-scroll-gallery\" id=\"collections\" aria-labelledby=\"moments-title\" data-lighting-gallery=\"\" style=\"--moment-runway: 2757px; --moment-progress: 0.528795609152752;\">\n  <header class=\"container moments-intro\">\n    <div><p class=\"eyebrow\">02 / Our lighting collections</p><h2 id=\"moments-title\">Lighting for Every Moment</h2></div>\n    <p>From contemporary interiors to architectural exteriors, explore lighting solutions designed for different spaces, applications and experiences.</p>\n    <a class=\"moments-skip\" href=\"#collections-end\">Skip the gallery</a>\n  </header>\n  <div class=\"moments-runway\">\n    <div class=\"moments-pin\">\n      <div class=\"moments-viewport\" aria-label=\"Lighting collections\">\n        <ul class=\"moments-track\" style=\"transform: translate3d(-1013.09px, 0px, 0px);\">\n          \n          <li class=\"moment-card\" data-category=\"indoor-lighting-1\" style=\"transform: perspective(1200px) translateY(12px) rotateY(16deg) scale(0.955);\">\n            <a class=\"moment-link\" href=\"/products/indoor-lighting-1/\" aria-labelledby=\"moment-title-1\">\n              <img src=\"/static/images/homepg-6.webp\" alt=\"Warm living room with perimeter ceiling lighting\" width=\"600\" height=\"800\" loading=\"lazy\" decoding=\"async\">\n              <span class=\"moment-number\" aria-hidden=\"true\">01 / 09</span>\n              <div class=\"moment-caption\"><p>NCCT / Lighting collection</p><h3 id=\"moment-title-1\">Indoor lighting</h3><span class=\"moment-explore\">Explore collection</span></div>\n            </a>\n          </li>\n          \n          <li class=\"moment-card\" data-category=\"outdoor-lighting-2\" style=\"transform: perspective(1200px) translateY(12px) rotateY(16deg) scale(0.955);\">\n            <a class=\"moment-link\" href=\"/products/outdoor-lighting-2/\" aria-labelledby=\"moment-title-2\">\n              <img src=\"/static/images/outside.webp\